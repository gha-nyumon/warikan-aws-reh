# このファイルを terraform.tfvars という名前でコピーし、自分の値に書き換えてから apply する
# （terraform.tfvars はリポジトリに入れない。.gitignore 済み）
region          = "ap-northeast-1"  # CloudShell の画面の右上のリージョン
github_owner    = "my-team"         # 自分のユーザー名または Organization 名
github_owner_id = 1234567           # curl -s https://api.github.com/repos/所有者/リポジトリ | jq .owner.id
github_repo     = "warikan-aws"
github_repo_id  = 98765432          # curl -s https://api.github.com/repos/所有者/リポジトリ | jq .id
